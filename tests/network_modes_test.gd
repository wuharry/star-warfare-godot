extends Node
const Rules = preload("res://scripts/core/match_rules.gd")
const World = preload("res://scripts/game/network_world.gd")
const Lobby = preload("res://scripts/ui/multiplayer_lobby.gd")
var failures: Array[String] = []
var checks := 0

func _ready() -> void:
	_run.call_deferred()

func check(condition: bool, message: String) -> void:
	checks += 1
	if not condition:
		failures.append(message)
		push_error(message)

func match_for(mode: String) -> RefCounted:
	var rules := Rules.new()
	rules.begin({"mode": mode, "score_limit": 10000}, {1: {"name": "A", "team": 0}, 2: {"name": "B", "team": 1}, 3: {"name": "C", "team": 0}})
	return rules

func _run() -> void:
	for mode: String in Rules.MODES:
		var r = match_for(mode)
		check(not r.can_damage(1, 1), mode + " rejects self-damage")
		check(r.can_damage(1, 2) == not Rules.is_coop(mode), mode + " PvP/coop targeting")
		check(r.can_damage(1, 3) == (not Rules.is_coop(mode) and not Rules.is_team(mode)), mode + " team targeting")
		check(r.config.level in (range(1, 9) if Rules.is_coop(mode) else range(13, 22)), mode + " valid map")
	var ffa = match_for("VS_FFA")
	ffa.player_died(2, 1, Vector3.ZERO)
	check(ffa.players[1].score == 50 and ffa.players[1].kills == 1, "FFA kill scores 50")
	ffa.player_died(2, 1, Vector3.ZERO)
	check(ffa.players[1].score == 50, "Duplicate death cannot score")
	check(ffa.tick(14.9).is_empty(), "No early respawn during death plus VS wait")
	check(2 in ffa.tick(0.2), "4-second death plus 11-second VS respawn")
	var tdm = match_for("VS_TDM")
	tdm.player_died(2, 1, Vector3.ZERO)
	check(tdm.team_scores[0] == 40, "TDM team kill scores 40")
	var flag = match_for("CTF_TDM")
	check(flag.pick_flag(1), "Flag pickup")
	flag.tick(25.0)
	flag.drop_flag(Vector3.ONE)
	flag.tick(4.0)
	check(is_equal_approx(flag.flag_left, 15.0), "Dropped flag pauses timer")
	flag.pick_flag(3)
	check(is_equal_approx(flag.flag_left, 15.0), "Same-team pickup preserves time")
	flag.drop_flag(Vector3.ZERO)
	flag.pick_flag(2)
	check(flag.flag_left == 40.0, "Enemy pickup resets time")
	flag.tick(40.0)
	check(flag.team_scores[1] == 100 and flag.flag_carrier == 0, "Team hold scores/reset")
	check(flag.damage_multiplier(2) == 1.5, "CTF team 10-second attack bonus")
	var solo_flag = match_for("CTF_FFA")
	solo_flag.pick_flag(1)
	solo_flag.tick(36.0)
	solo_flag.drop_flag(Vector3.ZERO)
	solo_flag.pick_flag(2)
	check(solo_flag.flag_left == 10.0, "FFA catch minimum ten seconds")
	solo_flag.tick(10.0)
	check(solo_flag.players[2].score == 100 and solo_flag.damage_multiplier(2) == 2.0, "FFA secure flag score/buff")
	var vip = match_for("VIP")
	var first := int(vip.vip_id)
	vip.tick(50.0)
	check(vip.players[first].score == 100 and vip.vip_id != first, "VIP survives, scores and rotates")
	var victim := int(vip.vip_id)
	vip.player_died(victim, 1, Vector3.ZERO)
	check(vip.players[1].score == 250, "VIP kill scores 150")
	var cmi = match_for("CMI")
	for kind in range(5):
		cmi.gift_destroyed(1, kind)
	check(cmi.team_scores[0] == 90, "CMI source scores 5/10/25/50/0")
	var coop = match_for("Survival")
	coop.tick(3601.0)
	check(not coop.ended, "Survival has no timed victory")
	for id in [1, 2, 3]:
		coop.player_died(id, 0, Vector3.ZERO)
	coop.tick(4.0)
	check(coop.ended and not coop.result.coop_win, "Coop all-dead defeat")
	var revive = match_for("Boss")
	for id in [1, 2, 3]: revive.player_died(id, 0, Vector3.ZERO, id == 1)
	revive.tick(3.9)
	check(not revive.ended and not revive.can_revive(1), "All-down retains four-second death animation")
	revive.tick(0.2)
	check(revive.can_revive(1) and revive.complete_revival(1), "Aid rescues all-down coop in source five-second window")
	revive.tick(9.0)
	check(not revive.ended and revive.players[1].alive, "Completed revival prevents all-down loss")
	var expired = match_for("Boss")
	for id in [1, 2, 3]: expired.player_died(id, 0, Vector3.ZERO, true)
	expired.tick(9.0)
	check(expired.ended and not expired.can_revive(1), "Expired all-down aid window ends encounter")
	var aid_vs = match_for("VS_FFA")
	aid_vs.player_died(2, 1, Vector3.ZERO, true)
	aid_vs.tick(4.0)
	check(aid_vs.complete_revival(2) and aid_vs.tick(30.0).is_empty(), "PvP aid wins once and cancels scheduled automatic respawn")
	aid_vs.player_died(2, 1, Vector3.ZERO, true)
	check(aid_vs.tick(19.9).is_empty() and 2 in aid_vs.tick(0.2) and not aid_vs.complete_revival(2), "PvP 4+5+11 automatic respawn rejects later aid")
	var boss = match_for("Boss")
	boss.enemy_killed(1, false)
	check(not boss.ended, "Boss escorts do not win match")
	boss.enemy_killed(1, true)
	check(boss.ended and boss.result.coop_win, "Boss death wins")
	var timed = match_for("VS_FFA")
	timed.tick(601.0)
	check(timed.ended and timed.result.draw, "Equal timeout is draw")
	var quit = match_for("CTF_TDM")
	quit.pick_flag(2)
	quit.remove_player(2, Vector3.ONE)
	check(quit.ended and quit.flag_carrier == 0 and 1 in quit.result.winners, "Carrier disconnect drops flag and forfeits")
	var capped = match_for("VS_FFA")
	capped.config.score_limit = 100
	capped.add_score(1, 100)
	capped.add_score(2, 1000)
	check(capped.ended and capped.result.winners == [1] and capped.players[2].score == 0, "Terminal results immutable")
	var bad := Rules.normalized_config({"mode": "fake", "level": -1, "max_players": 99, "time_limit": -2})
	check(bad.mode == "VS_FFA" and bad.level == 13 and bad.max_players == 8 and bad.time_limit == 60, "Untrusted room validation")
	check(Rules.normalized_config({"mode": "Boss", "max_players": 1}).max_players == 1, "Source coop allows one player")
	check(Rules.normalized_config({"mode": "Survival", "max_players": 99}).max_players == 3, "Source coop capacity is three")
	check(Rules.vs_health(10000.0) == 499.0, "Source HP exponent 0.65/2+300")
	check(is_equal_approx(Rules.vs_damage(1000.0, "hitscan"), 79.43282347), "Source damage exponent 0.3*10")
	var profile := NetworkSession._clean_profile({"weapons": ["gun00", "gun00", "unknown"], "weapon_levels": {"gun00": 999},
		"outfit": {"bag": "armor_bag_02", "head": "armor_bag_02"},
		"package_slots": ["gun00", "prop00", "prop00", "prop07"], "prop_counts": {"prop00": 1, "prop07": "bad"}})
	check(profile.weapons == ["gun00"] and profile.outfit.head != "armor_bag_02", "Profile weapon whitelist/dedupe and armor part validation")
	check(profile.package_slots == ["gun00", "prop00", "", ""], "Props keep source slot index and cannot exceed declared count")
	check(profile.weapon_levels.gun00 == GameState.Source.WEAPON_UPGRADE_ROWS.size(), "Weapon levels bounded by source upgrade rows")
	var lobby := Lobby.new()
	add_child(lobby)
	check(lobby.mode_picker.item_count == 8, "Eight playable lobby modes")
	lobby.queue_free()
	await get_tree().process_frame
	print("NETWORK_MODES_%s checks=%d failures=%s" % ["PASS" if failures.is_empty() else "FAIL", checks, str(failures)])
	get_tree().quit(0 if failures.is_empty() else 1)
