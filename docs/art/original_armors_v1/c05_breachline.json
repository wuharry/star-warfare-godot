  "proposed_abilities": [
    {
      "id": "c05_advancing_fire",
      "name": "推線穩架",
      "kind": "四件套條件被動提案",
      "implemented": false,
      "trigger": "存活且完整四件，接地、步行前進且持續射擊；移動方向與瞄準方向夾角不大於45度，移速至少達基礎步行速度的40%，轉向角速度不大於每秒45度",
      "effect": "符合條件時用1.5秒把穩定度從0累積到1；後座與擴散增量最多降低25%，隨穩定度線性增加",
      "stop": "急停、後退、側向超出角度、轉向超限、離地、換彈、換武器、死亡或卸裝立即清零；停止射擊超過0.6秒或該武器一個正常射擊間隔（取較長者）也清零",
      "limits": "不增加傷害、射速、暴擊或彈藥，不縮小武器靜止時的基礎散布；衝刺與位移技能不算步行；只適用具後座或擴散的槍械，近戰與投擲不觸發",
      "visual": "裝甲青色圓節點隨穩定度短亮；B-05 不承接這項能力。",
      "design_reason": "以保持推進方向換取可讀的穩定射擊優勢，急轉火力與穩定推進各有代價",
      "integration_note": "需有效射擊事件、移動／瞄準角度與轉向速度量測，以及武器後座和擴散接口；本輪僅定義規格",
      "status": "proposal_only",
      "equipment_dependency": "完整C裝甲四件；不要求同序B背包，不改B背包現有屬性。"
    }
  ],
